<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.2" />
    <PackageReference Include="FluentAssertions" Version="8.9.0" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="9.0.4" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="9.0.8" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ActivityExplorer.Core\ActivityExplorer.Core.csproj" />
    <ProjectReference Include="..\ActivityExplorer.Data\ActivityExplorer.Data.csproj" />
    <ProjectReference Include="..\ActivityExplorer.Services\ActivityExplorer.Services.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Include controller sources directly to avoid API project build lock issues -->
    <Compile Include="..\ActivityExplorer.API\Controllers\ActivitiesController.cs" Link="Controllers\ActivitiesController.cs" />
    <Compile Include="..\ActivityExplorer.API\Controllers\FiltersController.cs" Link="Controllers\FiltersController.cs" />
  </ItemGroup>

</Project>
