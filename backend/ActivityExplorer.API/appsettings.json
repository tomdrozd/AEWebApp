{
  "ConnectionStrings": {
    "ActivityDatabase": "Server=(localdb)\\mssqllocaldb;Database=ActivityExplorer;Trusted_Connection=True;MultipleActiveResultSets=true"
  },
  "Purview": {
      "Organization": "drozdovo.cz",
      "AuthMethod": "Certificate",
      "AppId": "f88ad2f0-dd16-4b4f-ab8b-5061605bd939",
      "TenantId": "c0da9875-a2ea-43e6-8b8c-26a288c83145",
      "CertificateThumbprint": "2F333B7E2923CA32F699E977F2952423990878F7",
      "CertificateStoreName": "My",
      "CertificateStoreLocation": "CurrentUser"
    },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173", "http://localhost:3000", "http://localhost:3001" ]
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://localhost:5000"
      }
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/activity-explorer-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName" ]
  },
  "AllowedHosts": "*"
}
